# wolfBoot configuration for AMD Versal AI Edge / Prime Gen 2 (VEK385),
# Linux boot (local QEMU Linux test, not run in CI).
#
# This is the Linux-payload variant of versal2_vek385.config. The flash
# layout, addresses, signing, OSPI driver and partition geometry are
# IDENTICAL to versal2_vek385.config (same addresses must later work on
# the board); only the payload handling differs:
#
#   - the signed image in the BOOT/UPDATE partitions is a FIT
#     (kernel + DTB + initramfs), built by
#     tools/scripts/versal2/qemu/linux/mk_fit.sh and signed v1 by
#     tools/keytools/sign (GZIP=1: the kernel sub-image is Image.gz);
#   - WOLFBOOT_LOAD_RAMDISK_ADDRESS is set so the initramfs is staged in
#     a fixed, reserved-memory-safe DDR region (768 MB);
#   - the kernel/DTB load addresses come from the FIT itself (the ITS
#     sets load/entry), so WOLFBOOT_LOAD_KERNEL_ADDRESS stays 0
#     ("honor the FIT").
#
# The bare-metal test-app config is versal2_vek385.config (used by CI
# and tools/scripts/versal2/qemu/test_qemu.sh); this file is a separate
# example.
#
# The QEMU boot flow (trampoline), the DTB generation
# (tools/scripts/versal2/qemu/linux/mk_dtb.sh) and the Linux
# update/confirm/rollback tests (tools/scripts/versal2/qemu/linux/
# test_linux.sh, L1-L4) are described in the "Versal Gen 2 VEK385"
# section of docs/Targets.md.

ARCH?=AARCH64
TARGET?=versal2
# Board on the wolfHAL drivers: hal/boards/vek385 (see docs/wolfHAL.md).
BOARD?=vek385
WOLFHAL?=1

WOLFBOOT_VERSION?=1

# ECC-384 signatures with SHA-384 hashes
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=512

# Debug options
DEBUG?=1
DEBUG_SYMBOLS=1
DEBUG_UART=1

# Optional: time the boot steps (flash read, hash, signature check).
BOOT_BENCHMARK?=1

VTOR?=1
CORTEX_M0?=0
NO_ASM?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0

# A/B boot from the OSPI NOR flash (Micron MT35XU02GCBA, 256 MB).
# See hal/boards/vek385.
EXT_FLASH?=1
NO_XIP=1

# How flash is read: 1 = CSU DMA (default, AM026 p706), 0 = STIG.
WOLFBOOT_OSPI_DMA?=1
# Only add the -D for DMA (see versal2_vek385.config).
ifeq ($(WOLFBOOT_OSPI_DMA),1)
CFLAGS_EXTRA+=-DWOLFBOOT_OSPI_DMA=1
endif

# Linux starts at EL2 with the MMU off, as the ARM64 boot rules need
# (do_boot() in src/boot_aarch64.c). Linux needs SCR_EL3.HCE, which the
# QEMU trampoline sets. BOOT_EL1 still works as a safe fallback.
BOOT_EL2=1
WOLFBOOT_VERSAL2_EL2_MMU_OFF=1
#BOOT_EL1=1

# ELF loading support
ELF?=1

# Unzip gzip FIT parts: the kernel (Image.gz) and the initramfs. This
# keeps the signed FIT inside the 44 MB partition.
GZIP?=1

# Load the FIT ramdisk (initramfs) and tell Linux where it is.
# The initramfs is the only root file system, so no root= is needed.
FIT_RAMDISK?=1
FIT_RAMDISK_REQUIRED?=1

# 0 = use the FIT's kernel load address (0x24000000, 576 MB). It is clear
# of the RPU reserved memory and the FIT copy at 0x20000000.
WOLFBOOT_LOAD_KERNEL_ADDRESS?=0

# Ramdisk load address: 768 MB, clear of the kernel and the FIT copy.
WOLFBOOT_LOAD_RAMDISK_ADDRESS=0x30000000

# Toolchain (the CI container provides aarch64-linux-gnu-)
USE_GCC=1
CROSS_COMPILE=aarch64-linux-gnu-

# ============================================================================
# Boot Memory Layout
# ============================================================================
# Same as versal2_vek385.config: PLM 0-16 MB, TF-A 16-22 MB, RPU reserved
# memory ends at 0x1E4E7FFF; wolfBoot runs from DDR at 0x40000000.
WOLFBOOT_ORIGIN=0x40000000

# Where the whole signed FIT is copied: 512 MB, above the RPU memory.
WOLFBOOT_LOAD_ADDRESS?=0x20000000

# DTS load address in RAM: 496 MB, after the RPU reserved memory and
# before the FIT. Clear of OP-TEE (0x1800000, 128 MB) if it is used.
WOLFBOOT_LOAD_DTS_ADDRESS=0x1F000000

# DTS slots in flash, after the UPDATE partition, 8 MB apart. Not used
# here, because the Linux FIT has its own DTB.
WOLFBOOT_DTS_BOOT_ADDRESS=0x7600000
WOLFBOOT_DTS_UPDATE_ADDRESS=0x7E00000

# ============================================================================
# OSPI Flash Partitions (identical to versal2_vek385.config)
# ============================================================================
# Bank A: 0x015C0000 BOOT.BIN (8 MB kept), 0x01DC0000 BOOT (44 MB),
#   0x049C0000 UPDATE (44 MB), 0x07600000 / 0x07E00000 DTS slots.
# The driver refuses erase/program outside BOOT, UPDATE and SWAP.

# One wolfBoot sector = one 128 KB flash sector (DCh), as on Gen 1.
WOLFBOOT_SECTOR_SIZE=0x20000

# Partition size: 44 MB. The signed FIT must fit; mk_fit.sh checks this.
WOLFBOOT_PARTITION_SIZE=0x2C00000

# BOOT partition, right after the 8 MB BOOT.BIN area
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x1DC0000

# UPDATE partition
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x49C0000

# SWAP partition (one sector), in AMD's "User Scratchpad" area
WOLFBOOT_PARTITION_SWAP_ADDRESS=0xFA40000

# Faster reads with bigger blocks
CFLAGS_EXTRA+=-DWOLFBOOT_SHA_BLOCK_SIZE=4096

# Console: UART1 (0xF1930000), for both wolfBoot and Linux.
CFLAGS_EXTRA+=-DDEBUG_UART_NUM=1

# UART clock, used only if the UART starts off (see versal2_vek385.config).
#DEBUG_UART_CLK_HZ=100000000

# In QEMU, the same trampoline as the test-app loads wolfBoot and acts
# like BL31 (tools/scripts/versal2/qemu/linux/).
