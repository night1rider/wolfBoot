# wolfBoot configuration for AMD Versal AI Edge / Prime Gen 2 (VEK385),
# Linux boot (PR 1, plan item Q5 "Local Linux test (not CI)").
#
# This is the Linux-payload variant of versal2_vek385.config. The flash
# layout, addresses, signing, OSPI driver and partition geometry are
# IDENTICAL to versal2_vek385.config (same addresses must later work on
# the board); only the payload handling differs:
#
#   - the signed image in the BOOT/UPDATE partitions is a FIT
#     (kernel + DTB + initramfs), built by
#     tools/scripts/versal2/qemu/linux/mk_fit.sh and signed v1 by
#     tools/keytools/sign (GZIP=1: the kernel sub-image is Image.gz);
#   - WOLFBOOT_LOAD_RAMDISK_ADDRESS is set so the initramfs is staged in
#     a fixed, reserved-memory-safe DDR region (768 MB);
#   - the kernel/DTB load addresses come from the FIT itself (the ITS
#     sets load/entry), so WOLFBOOT_LOAD_KERNEL_ADDRESS stays 0
#     ("honor the FIT").
#
# The bare-metal test-app config versal2_vek385.config, its CI workflow
# and the 23-check QEMU suite (tools/scripts/versal2/qemu/test_qemu.sh)
# are untouched; this file is a separate example.
#
# See BUILD.md ("Run 5") for the QEMU boot flow (trampoline), the DTB
# generation (tools/scripts/versal2/qemu/linux/mk_dtb.sh) and the Linux
# update/confirm/rollback tests (tools/scripts/versal2/qemu/linux/
# test_linux.sh, L1-L4).

ARCH?=AARCH64
TARGET?=versal2

WOLFBOOT_VERSION?=1

# ECC-384 with SHA-384 (good balance of security and performance)
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=512

# Debug options
DEBUG?=1
DEBUG_SYMBOLS=1
DEBUG_UART=1

# Boot Benchmarking (optional):
# Enables timing of boot operations (flash read, integrity, signature).
BOOT_BENCHMARK?=1

VTOR?=1
CORTEX_M0?=0
NO_ASM?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0

# Flash configuration: A/B boot over the OSPI (Cadence) NOR flash
# (Micron MT35XU02GCBA, 256 MB, 4-byte addressed). See hal/versal2.c.
EXT_FLASH?=1
NO_XIP=1

# OSPI read data path: 1 = CSU DMA read (default; AM026 p706, xospipsv
# sequence, proven in QEMU 11.1.3); 0 = STIG (selectable fallback).
# See versal2_vek385.config.
WOLFBOOT_OSPI_DMA?=1
# The HAL picks the data path with `#ifdef WOLFBOOT_OSPI_DMA` (defined =
# DMA, undefined = STIG), so emit -D only when DMA is requested (see
# versal2_vek385.config).
ifeq ($(WOLFBOOT_OSPI_DMA),1)
CFLAGS_EXTRA+=-DWOLFBOOT_OSPI_DMA=1
endif

# Boot Exception Level. Default is BOOT_EL2 (Run 10): wolfBoot runs at
# EL2 (the QEMU trampoline drops EL3 -> EL2; hal/versal2.h EL2_HYPERVISOR)
# and hands the kernel to EL2 with the MMU/caches OFF - the ARM64 boot
# protocol - via WOLFBOOT_VERSAL2_EL2_MMU_OFF=1 (see do_boot() in
# src/boot_aarch64.c). The kernel records the MMU-off entry in
# record_mmu_state() and finalise_el2() then switches it to VHE (EL2
# host) via the "hvc #0" -> __finalise_el2 path, which needs SCR_EL3.HCE
# (bit 8): the QEMU trampoline sets SCR_EL3 = 0x909 (NS|EA|HCE|ST). With
# HCE=0 that hvc is UNDEFINED at EL1 and the kernel panics in
# finalise_el2 (the Run 6 blocker, now fixed). The MMU-off handoff is
# required for a non-EFI boot: with the MMU still on,
# check_mmu_enabled_at_boot() panics with "Non-EFI boot detected with MMU
# and caches enabled". Verified Run 10: the EDF kernel boots to the
# initramfs shell at EL2 (VHE) in QEMU 11.1.3.
#
# BOOT_EL1 (the Run 6 default, still supported as the board-safe
# fallback): wolfBoot drops the kernel to EL1 via el2_to_el1_boot() (DTB
# in x0, CNTHCTL_EL2 opened for EL1, HCR_EL2=RW|HCD, SPSR=EL1h); the
# kernel then boots at EL1 and never executes the VHE hyp-stub path. On
# the board the same wolfBoot image can hand off either way.
BOOT_EL2=1
WOLFBOOT_VERSAL2_EL2_MMU_OFF=1
#BOOT_EL1=1

# ELF loading support
ELF?=1

# Native gzip decompression for FIT subimages: the FIT kernel sub-image
# is Image.gz (EDF kernel, 33 MB uncompressed; the gzip sub-image and
# the gzip initramfs keep the whole signed FIT inside the 44 MB
# partitions) and the initramfs cpio is gzip-compressed in the FIT.
GZIP?=1

# FIT ramdisk (initramfs) extraction plus the /chosen/linux,initrd-{start,end}
# fixup. The initramfs is the only root filesystem (busybox shell + the
# update tool); no root= argument is needed on the kernel command line.
FIT_RAMDISK?=1
FIT_RAMDISK_REQUIRED?=1

# Load address for the FIT kernel sub-image, overriding the FIT's own
# `load`/`entry`. 0 honors the FIT (the ITS sets load/entry = 0x24000000,
# 576 MB: clears the RPU reserved regions (end 0x1E4E7FFF) and the FIT
# staging area at 0x20000000; valid on the board's 2 GB low DDR).
WOLFBOOT_LOAD_KERNEL_ADDRESS?=0

# Fixed ramdisk stage address: 768 MB. Clears the decompressed kernel
# (0x24000000 + ~33 MB) and the FIT staging (0x20000000 + ~44 MB);
# below the 2 GB low-DRAM bound on the board. 0 would honor the FIT's
# own ramdisk `load` property instead.
WOLFBOOT_LOAD_RAMDISK_ADDRESS=0x30000000

# Toolchain (the CI container provides aarch64-linux-gnu-)
USE_GCC=1
CROSS_COMPILE=aarch64-linux-gnu-

# ============================================================================
# Boot Memory Layout
# ============================================================================
# Identical to versal2_vek385.config (task-list.md section 2 DDR map and
# reserved areas; the same config must later work on the board):
#   PLM owns 0-16 MB, TF-A 16-22 MB, RPU reserved regions end at
#   0x1E4E7FFF; wolfBoot runs from DDR at 0x40000000.
WOLFBOOT_ORIGIN=0x40000000

# Signed image (the whole FIT) stage address: 512 MB. Clears the RPU
# reserved regions (end 0x1E4E7FFF ~ 502 MB).
WOLFBOOT_LOAD_ADDRESS?=0x20000000

# DTS load address (RAM): 24 MB - above the PLM (0-16 MB) and TF-A
# (16-22 MB) regions, below the RPU reservations (start 0x0C000000).
WOLFBOOT_LOAD_DTS_ADDRESS=0x1800000

# Standalone DTS slots in OSPI flash (Bank A, after the UPDATE partition).
# Only read by wolfBoot when a loaded image carries no embedded fdt; the
# Linux FIT carries its own DTB, so these are unused on the Linux path.
# Run 13 layout decision: 8 MB BOOT.BIN reservation (AMD BOOT.BIN 5.31 MiB,
# evidence/mdom-bank-analysis-run9.txt) moved BOOT/UPDATE up; the old slots
# (0x7200000/0x7A00000) now sit INSIDE the new UPDATE partition
# (0x49C0000-0x75BFFFF), so the "after the UPDATE partition" invariant
# forces them to the next free 1 MB-aligned pair after UPDATE (the same
# 8 MB spacing as before):
#   WOLFBOOT_DTS_BOOT_ADDRESS=0x7200000
#   WOLFBOOT_DTS_UPDATE_ADDRESS=0x7A00000
WOLFBOOT_DTS_BOOT_ADDRESS=0x7600000
WOLFBOOT_DTS_UPDATE_ADDRESS=0x7E00000

# ============================================================================
# OSPI Flash Partitions (identical to versal2_vek385.config, run-13 layout)
# ============================================================================
# Bank A usage (128 KB aligned):
#   0x015C0000 - 0x01DBFFFF : BOOT.BIN reservation (PLM + TF-A + wolfBoot
#                             image; PR 2). 8 MB reserved (run 13 layout
#                             decision; AMD's real BOOT.BIN is 5.31 MiB,
#                             evidence/mdom-bank-analysis-run9.txt).
#                             Old (run 3-12) reservation: 4 MB, ending
#                             0x019BFFFF.
#   0x01DC0000              : wolfBoot BOOT partition   (44 MB)
#   0x049C0000              : wolfBoot UPDATE partition (44 MB)
#   0x07600000              : DTS boot slot (up to 1 MB)
#   0x07E00000              : DTS update slot (up to 1 MB)
#   everything ends before 0x087C0000 (end of Bank A)
#   Old (run 3-12) addresses, kept for reference: BOOT 0x019C0000,
#   UPDATE 0x04600000, DTS slots 0x07200000 / 0x07A00000.
#
# The OSPI driver enforces an address guard covering exactly these
# regions (BOOT / UPDATE / SWAP); every other flash address is refused
# for erase and program.

# OSPI erase granularity: 128 KB (0xDC) / 32 KB (0x5C) / 4 KB (0x21).
WOLFBOOT_SECTOR_SIZE=0x10000

# Application Partition Size (44 MB, same as Gen 1). The signed FIT
# (Image.gz + DTB + gzip initramfs carrying the next-version FIT) must
# fit here; see tools/scripts/versal2/qemu/linux/mk_fit.sh, which
# verifies the size at build time.
WOLFBOOT_PARTITION_SIZE=0x2C00000

# Primary boot partition (after the 8 MB BOOT.BIN reservation - run 13
# layout decision; the old 4 MB-reservation address, kept for reference:
#   WOLFBOOT_PARTITION_BOOT_ADDRESS=0x19C0000
# )
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x1DC0000

# Secondary (update) partition (old run 3-12 address, kept for
# reference: WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x4600000)
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x49C0000

# wolfBoot state/swap: the "User Scratchpad" area of AMD's layout (one
# erase sector).
WOLFBOOT_PARTITION_SWAP_ADDRESS=0xFA40000

# Speed up reads by using larger blocks
CFLAGS_EXTRA+=-DWOLFBOOT_SHA_BLOCK_SIZE=4096

# UART Configuration - UART1 (0xF1930000) is the VEK385 console and the
# Linux console (the kernel bootargs in the FIT DTB use it too).
CFLAGS_EXTRA+=-DDEBUG_UART_NUM=1

# UART reference clock (only used when the UART is found disabled).
# See versal2_vek385.config.
#DEBUG_UART_CLK_HZ=100000000

# QEMU bring-up note: the QEMU test loads wolfBoot.elf at WOLFBOOT_ORIGIN
# via an EL3 -> EL2 trampoline (tools/scripts/versal2/qemu/), emulating
# the BL31 hand-off. The Linux boot (plan item Q5) reuses the same
# trampoline; see tools/scripts/versal2/qemu/linux/.
