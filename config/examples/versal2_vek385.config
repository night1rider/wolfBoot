# wolfBoot configuration for AMD Versal AI Edge / Prime Gen 2 (VEK385)
# Cortex-A78AE, A/B boot over OSPI (Cadence) flash.
#
# This configuration is tested in QEMU `amd-versal2-virt` (QEMU 11.1.3);
# see the "Versal Gen 2 VEK385" section of docs/Targets.md and
# tools/scripts/versal2/qemu/test_qemu.sh. The addresses below follow
# AMD's OSPI layout (VEK385 DTB) and the RPU reserved-memory map, so the
# same layout is meant for the board.
#
# Production boot flow:
#   PLM -> PSM -> BL31 (EL3, secure) -> wolfBoot (EL2, non-secure) -> Linux
# PLM owns 0-16 MB of DDR, TF-A (BL31) owns 16-22 MB; wolfBoot enters at
# 0x40000000 (AMD default BL33 entry, per the VEK385 Rev B log
# "BL31: Non secure code at 0x40000000").

ARCH?=AARCH64
TARGET?=versal2
# Board on the wolfHAL drivers: hal/boards/vek385 (see docs/wolfHAL.md).
BOARD?=vek385
WOLFHAL?=1

WOLFBOOT_VERSION?=1

# ECC-384 signatures with SHA-384 hashes
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=512

# Debug options
DEBUG?=1
DEBUG_SYMBOLS=1
DEBUG_UART=1

# Optional: time the boot steps (flash read, hash, signature check).
BOOT_BENCHMARK?=1

VTOR?=1
CORTEX_M0?=0
NO_ASM?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0

# A/B boot from the OSPI NOR flash (Micron MT35XU02GCBA, 256 MB).
# See hal/boards/vek385.
EXT_FLASH?=1
NO_XIP=1

# How flash is read: 1 = CSU DMA (default, AM026 p706), 0 = STIG.
# test_qemu.sh tests both.
WOLFBOOT_OSPI_DMA?=1
# The code checks `#ifdef WOLFBOOT_OSPI_DMA`, so only add the -D for DMA.
# A -DWOLFBOOT_OSPI_DMA=0 would still turn DMA on.
ifeq ($(WOLFBOOT_OSPI_DMA),1)
CFLAGS_EXTRA+=-DWOLFBOOT_OSPI_DMA=1
endif

# Which level the app starts at (pick one). Default: EL2, where wolfBoot
# runs. Dropping only one core to EL1 makes Linux report "CPUs started
# in inconsistent modes".
#BOOT_EL1=1
#BOOT_EL2=1

# ELF loading support
ELF?=1

# Unzip gzip FIT parts (set GZIP=0 to turn off)
GZIP?=1

# Load the FIT ramdisk (initramfs) and tell Linux where it is.
# A PetaLinux image.ub has one; without this it is ignored.
FIT_RAMDISK?=1

# Kernel load address, used instead of the FIT's own. Needed if the FIT
# has no load/entry. 0 = use the FIT's value.
#WOLFBOOT_LOAD_KERNEL_ADDRESS?=0x2001000

# Same for the ramdisk: 0 = use the ramdisk's own load address.
#WOLFBOOT_LOAD_RAMDISK_ADDRESS?=0x40000000

# Toolchain (the CI container provides aarch64-linux-gnu-)
USE_GCC=1
CROSS_COMPILE=aarch64-linux-gnu-

# ============================================================================
# Boot Memory Layout
# ============================================================================
# wolfBoot runs from DDR at 0x40000000. Load addresses stay clear of the
# RPU reserved memory, which ends at 0x1E4E7FFF (DTB reserved-memory).
WOLFBOOT_ORIGIN=0x40000000

# Application (Linux kernel / FIT) load address: 512 MB.
WOLFBOOT_LOAD_ADDRESS?=0x20000000

# DTS load address in RAM: 496 MB, after the RPU reserved memory and
# before the app. Clear of OP-TEE (0x1800000, 128 MB) if it is used.
WOLFBOOT_LOAD_DTS_ADDRESS=0x1F000000

# DTS slots in flash, after the UPDATE partition, 8 MB apart.
# Only used when the image has no built-in fdt.
WOLFBOOT_DTS_BOOT_ADDRESS=0x7600000
WOLFBOOT_DTS_UPDATE_ADDRESS=0x7E00000

# ============================================================================
# OSPI Flash Partitions
# ============================================================================
# AMD OSPI layout (VEK385 DTB, /axi/spi@f1010000/flash@0/partitions):
#   0x0000000  Image Selector (384 KB)            - DO NOT TOUCH
#   0x0060000  Image Selector Backup (384 KB)     - DO NOT TOUCH
#   0x00C0000  Image Selector Scratchpad (128 KB) - DO NOT TOUCH
#   0x00E0000  Image Recovery (20 MB)             - DO NOT TOUCH
#   0x14E0000  Image Recovery Scratchpad (128 KB) - DO NOT TOUCH
#   0x1500000  SystemReady-DT metadata (128 KB)   - DO NOT TOUCH
#   0x1520000  SystemReady-DT metadata Backup     - DO NOT TOUCH
#   0x1540000  U-Boot Variables (128 KB)          - DO NOT TOUCH
#   0x1560000  U-Boot Variables Backup (128 KB)   - DO NOT TOUCH
#   0x1580000  U-Boot UEFI Variables (256 KB)     - DO NOT TOUCH
#   0x15C0000  Bank A Space (114 MB, ends 0x87C0000) <- wolfBoot partitions
#   0x8800000  Bank B Space (114 MB)              - DO NOT TOUCH
#   0xFA40000  User Scratchpad (5.75 MB)          <- wolfBoot SWAP
#
# Bank A: 0x015C0000 BOOT.BIN (8 MB kept), 0x01DC0000 BOOT (44 MB),
#   0x049C0000 UPDATE (44 MB), 0x07600000 / 0x07E00000 DTS slots.
# The driver refuses erase/program outside BOOT, UPDATE and SWAP.

# One wolfBoot sector = one 128 KB flash sector (DCh), as on Gen 1.
# The flash has no 64 KB erase (datasheet Table 21/32, p32/p50).
WOLFBOOT_SECTOR_SIZE=0x20000

# Partition size: 44 MB, same as Gen 1 (fits the signed FIT)
WOLFBOOT_PARTITION_SIZE=0x2C00000

# BOOT partition, right after the 8 MB BOOT.BIN area
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x1DC0000

# UPDATE partition
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x49C0000

# SWAP partition (one sector), in AMD's "User Scratchpad" area
WOLFBOOT_PARTITION_SWAP_ADDRESS=0xFA40000

# Faster reads with bigger blocks
CFLAGS_EXTRA+=-DWOLFBOOT_SHA_BLOCK_SIZE=4096

# Console: UART1 (0xF1930000). DEBUG_UART_NUM=0 picks UART0 (0xF1920000).
CFLAGS_EXTRA+=-DDEBUG_UART_NUM=1

# UART clock, used only if the UART starts off (QEMU with no trampoline).
# Default 100 MHz (DS1021 Table 51). Change it if your board differs.
#DEBUG_UART_CLK_HZ=100000000

# In QEMU, a small trampoline loads wolfBoot at WOLFBOOT_ORIGIN and acts
# like BL31 (tools/scripts/versal2/qemu/).
