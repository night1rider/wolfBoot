# wolfBoot configuration for AMD Versal AI Edge / Prime Gen 2 (VEK385)
# Cortex-A78AE, A/B boot over OSPI (Cadence) flash.
#
# This configuration is proven in QEMU `amd-versal2-virt` (QEMU 10.2+),
# see BUILD.md and tools/scripts/versal2/ for the bring-up evidence and
# the Q5 feature tests. PR 2 (board) reuses the addresses below, which
# follow AMD's OSPI layout (VEK385 DTB) and the RPU reserved-memory map.
#
# Production boot flow:
#   PLM -> PSM -> BL31 (EL3, secure) -> wolfBoot (EL2, non-secure) -> Linux
# PLM owns 0-16 MB of DDR, TF-A (BL31) owns 16-22 MB; wolfBoot enters at
# 0x40000000 (AMD default BL33 entry, per the VEK385 Rev B log
# "BL31: Non secure code at 0x40000000").

ARCH?=AARCH64
TARGET?=versal2

WOLFBOOT_VERSION?=1

# ECC-384 with SHA-384 (good balance of security and performance)
SIGN?=ECC384
HASH?=SHA384
IMAGE_HEADER_SIZE?=512

# Debug options
DEBUG?=1
DEBUG_SYMBOLS=1
DEBUG_UART=1

# Boot Benchmarking (optional):
# Enables timing of boot operations (flash read, integrity, signature).
BOOT_BENCHMARK?=1

VTOR?=1
CORTEX_M0?=0
NO_ASM?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
V?=0
SPMATH?=1
RAM_CODE?=0
DUALBANK_SWAP?=0
PKA?=0
WOLFTPM?=0

# Flash configuration: A/B boot over the OSPI (Cadence) NOR flash
# (Micron MT35XU02GCBA, 256 MB, 4-byte addressed). See hal/versal2.c.
EXT_FLASH?=1
NO_XIP=1

# OSPI read data path: 1 = CSU DMA read (AM026 p706, xospipsv sequence;
# default); 0 = STIG (selectable, the proven fallback; the Q4 STIG check
# and the STIG suite run in tools/scripts/versal2/qemu/test_qemu.sh keep
# both paths tested). DMA is proven end-to-end in QEMU 11.1.3 (Q4
# DMA-1K/4K READBACK OK, and the full 23-check suite runs with the DMA
# default): the CSU DMA model completes the triggered read once
# CONFIG.ENB_DMA_IF (bit 15) is set, which ospi_dma_read() does via
# read-modify-write (on the board the PLM sets it at boot; QEMU has no
# PLM). See BUILD.md ("QEMU limitations") and the Q4 check in
# tools/scripts/versal2/qemu/.
WOLFBOOT_OSPI_DMA?=1
# The HAL picks the data path with `#ifdef WOLFBOOT_OSPI_DMA` (defined =
# DMA, undefined = STIG), so emit -D only when DMA is requested. Emitting
# -DWOLFBOOT_OSPI_DMA=0 unconditionally would still define the macro and
# keep the DMA path compiled in, making STIG unselectable.
ifeq ($(WOLFBOOT_OSPI_DMA),1)
CFLAGS_EXTRA+=-DWOLFBOOT_OSPI_DMA=1
endif

# Boot Exception Level (mutually exclusive)
#   BOOT_EL1: drop to EL1 via ERET before entering the application.
#   BOOT_EL2: enter the application at the EL2 wolfBoot runs at (default).
# EL2 is the default: PSCI would bring the secondary cores up at EL2, so
# dropping only the boot core leaves Linux with "CPUs started in
# inconsistent modes".
#BOOT_EL1=1
#BOOT_EL2=1

# ELF loading support
ELF?=1

# Native gzip decompression for FIT subimages (set GZIP=0 to disable)
GZIP?=1

# FIT ramdisk (initramfs) extraction plus the /chosen/linux,initrd-{start,end}
# fixup. A stock PetaLinux image.ub carries a ramdisk sub-image that a U-Boot
# "bootm" loads; without this wolfBoot ignores it.
FIT_RAMDISK?=1

# Load address for the FIT kernel sub-image, overriding the FIT's own
# `load`/`entry`. Needed when the ITS omits them. 0 honors the FIT.
#WOLFBOOT_LOAD_KERNEL_ADDRESS?=0x2001000

# Likewise for the ramdisk: 0 honors the ramdisk's own `load`.
#WOLFBOOT_LOAD_RAMDISK_ADDRESS?=0x40000000

# Toolchain (the CI container provides aarch64-linux-gnu-)
USE_GCC=1
CROSS_COMPILE=aarch64-linux-gnu-

# ============================================================================
# Boot Memory Layout
# ============================================================================
# wolfBoot runs from DDR at 0x40000000 (the AMD default BL33 entry address).
# The VEK385 low DDR is 2 GB at 0x0 (DTB /memory node); QEMU's low channel
# is 2046 MiB. All load addresses below clear the RPU reserved regions,
# which end at 0x1E4E7FFF (DTB reserved-memory).
WOLFBOOT_ORIGIN=0x40000000

# Application (Linux kernel / FIT) load address: 512 MB.
WOLFBOOT_LOAD_ADDRESS?=0x20000000

# DTS load address (RAM): 24 MB - above the PLM (0-16 MB) and TF-A
# (16-22 MB) regions, below the RPU reservations.
WOLFBOOT_LOAD_DTS_ADDRESS=0x1800000

# Standalone DTS slots in OSPI flash (Bank A, after the UPDATE partition).
# Only read by wolfBoot when a loaded image carries no embedded fdt.
# Run 13 layout decision: 8 MB BOOT.BIN reservation (AMD BOOT.BIN 5.31 MiB,
# evidence/mdom-bank-analysis-run9.txt) moved BOOT/UPDATE up; the old slots
# (0x7200000/0x7A00000) now sit INSIDE the new UPDATE partition
# (0x49C0000-0x75BFFFF), so the "after the UPDATE partition" invariant
# forces them to the next free 1 MB-aligned pair after UPDATE (the same
# 8 MB spacing as before):
#   WOLFBOOT_DTS_BOOT_ADDRESS=0x7200000
#   WOLFBOOT_DTS_UPDATE_ADDRESS=0x7A00000
WOLFBOOT_DTS_BOOT_ADDRESS=0x7600000
WOLFBOOT_DTS_UPDATE_ADDRESS=0x7E00000

# ============================================================================
# OSPI Flash Partitions
# ============================================================================
# AMD OSPI layout (VEK385 DTB, /axi/spi@f1010000/flash@0/partitions):
#   0x0000000  Image Selector (384 KB)            - DO NOT TOUCH
#   0x0600000  Image Selector Backup (384 KB)     - DO NOT TOUCH
#   0x0C00000  Image Selector Scratchpad (128 KB) - DO NOT TOUCH
#   0x0E00000  Image Recovery (20 MB)             - DO NOT TOUCH
#   0x14E0000  Image Recovery Scratchpad (128 KB) - DO NOT TOUCH
#   0x1500000  SystemReady-DT metadata (128 KB)   - DO NOT TOUCH
#   0x1520000  SystemReady-DT metadata Backup     - DO NOT TOUCH
#   0x1540000  U-Boot Variables (128 KB)          - DO NOT TOUCH
#   0x1560000  U-Boot Variables Backup (128 KB)   - DO NOT TOUCH
#   0x1580000  U-Boot UEFI Variables (256 KB)     - DO NOT TOUCH
#   0x15C0000  Bank A Space (114 MB, ends 0x87C0000) <- wolfBoot partitions
#   0x8800000  Bank B Space (114 MB)              - DO NOT TOUCH
#   0xFA40000  User Scratchpad (5.75 MB)          <- wolfBoot SWAP
#
# Bank A usage (128 KB aligned, run-13 layout):
#   0x015C0000 - 0x01DBFFFF : BOOT.BIN reservation (PLM + TF-A + wolfBoot
#                             image; PR 2). 8 MB reserved (run 13 layout
#                             decision): AMD's real multidomain BOOT.BIN
#                             is 5.31 MiB (0x54FE40; ends 0x1B0FE40) per
#                             evidence/mdom-bank-analysis-run9.txt +
#                             evidence/mdom-embedded-manifest.json, which
#                             overlaps the run-3 4 MB reservation's tail.
#                             Old (run 3-12) reservation, kept for
#                             reference:
#   0x015C0000 - 0x019BFFFF : BOOT.BIN (4 MB reserved)
#   0x01DC0000              : wolfBoot BOOT partition   (44 MB)
#   0x049C0000              : wolfBoot UPDATE partition (44 MB)
#   0x07600000              : DTS boot slot (up to 1 MB)
#   0x07E00000              : DTS update slot (up to 1 MB)
#   everything ends before 0x087C0000 (end of Bank A).
#   Old (run 3-12) partition addresses, kept for reference:
#   0x019C0000              : wolfBoot BOOT partition   (44 MB)
#   0x04600000              : wolfBoot UPDATE partition (44 MB)
#   0x07200000 / 0x07A00000 : DTS boot / update slots
#
# The OSPI driver enforces an address guard covering exactly these
# regions (BOOT / UPDATE / SWAP); every other flash address is refused
# for erase and program (see hal/versal2.c, task list section 6).

# OSPI erase granularity used by wolfBoot: the driver erases in 128 KB
# (0xDC), 32 KB (0x5C) or 4 KB (0x21) chunks as the alignment allows.
# (0xDC is the 128 KB sector erase on the MT35XU02GCBA; the device has
# no 64 KB erase - datasheet Table 21/32, p32/p50.)
WOLFBOOT_SECTOR_SIZE=0x10000

# Application Partition Size (44 MB, same as Gen 1; fits the signed FIT)
WOLFBOOT_PARTITION_SIZE=0x2C00000

# Primary boot partition (after the 8 MB BOOT.BIN reservation at the
# start of Bank A - run 13 layout decision; the old 4 MB-reservation
# address, kept for reference:
#   WOLFBOOT_PARTITION_BOOT_ADDRESS=0x19C0000
# )
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x1DC0000

# Secondary (update) partition (old run 3-12 address, kept for
# reference: WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x4600000)
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x49C0000

# wolfBoot state/swap: the "User Scratchpad" area of AMD's layout. The
# swap partition is WOLFBOOT_SECTOR_SIZE (one erase sector) at this
# address.
WOLFBOOT_PARTITION_SWAP_ADDRESS=0xFA40000

# Speed up reads by using larger blocks
CFLAGS_EXTRA+=-DWOLFBOOT_SHA_BLOCK_SIZE=4096

# UART Configuration - UART1 (0xF1930000) is the VEK385 console
# (DEBUG_UART_NUM=0 selects UART0 at 0xF1920000 instead; both variants
# are built and unit-tested).
CFLAGS_EXTRA+=-DDEBUG_UART_NUM=1

# UART reference clock for the baud-rate divisors, used only when the
# UART is found disabled (QEMU without the trampoline); on the board the
# PLM/BL31 leave the console enabled and their divisors are kept. Default
# 100 MHz = the documented FUART_REF_CLK limit (DS1021 Table 51) and the
# rate the QEMU trampoline programs; override if a board's PLM differs.
#DEBUG_UART_CLK_HZ=100000000

# QEMU bring-up note: the QEMU test loads wolfBoot.elf at WOLFBOOT_ORIGIN
# via an EL3 -> EL2 trampoline (tools/scripts/versal2/qemu/), emulating
# the BL31 hand-off. See BUILD.md.
